// Prisma schema for the dynamic journal binder app.
// Datasource URL is configured in prisma.config.ts (Prisma 7 convention).
// Image fields are plain String URLs that hold either a remote/legacy URL or a
// local "/api/assets/{id}" pointer; uploaded image bytes live in the Asset table.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
  JOURNAL_MANAGER
  VIEWER
}

enum JournalRole {
  EDITOR_IN_CHIEF
  ASSOCIATE_EDITOR_IN_CHIEF
  EDITORIAL_BOARD
  MANAGING_EDITOR
  ADVISOR
  REVIEWER
  MANAGEMENT_HEAD
  MANAGEMENT_MEMBER
}

enum SubscriptionMode {
  PRINT
  ONLINE
  PRINT_ONLINE
}

enum BinderType {
  REGULAR
  SPECIAL
}

enum JournalFrequency {
  ANNUAL
  BIANNUAL
  TRIANNUAL
  QUARTERLY
  BIMONTHLY
  MONTHLY
  OTHER
}

// Binder QA module: kind of PDF stored against a binder.
enum BinderFileKind {
  FRONT_MATTER // exported/uploaded initial-pages PDF
  MANUSCRIPT // one article's manuscript PDF (tied to an Article row)
  ASSEMBLED // front matter + manuscripts merged into the final binder
  COVER // cover spread PDF (kept separate — reviewed, never merged into the A4 binder)
}

// Where a binder sits in the QA → internal review workflow.
enum BinderReviewStatus {
  DRAFT
  IN_INTERNAL_REVIEW
}

enum QaRunStatus {
  RUNNING
  COMPLETE
  ERROR
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedAssets Asset[]
  editedBinders  Binder[]
  // Journals this login account (a JOURNAL_MANAGER) is allowed to edit. Distinct
  // from Journal.manager, which is a display Profile — this is an access grant.
  managedJournals Journal[]  @relation("JournalManagerUsers")
  auditLogs       AuditLog[]
  binderFiles      BinderFile[]
  qaRuns           BinderQaRun[]
  submittedBinders Binder[]      @relation("BinderSubmitter")
}

// Append-only record of catalog changes (currently journal create/update/delete),
// shown in the admin-only /admin/logs activity page. actorEmail/actorName are
// snapshots so the entry survives the user being deleted.
model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "journal.update", "journal.create", "journal.delete"
  actorId    String?
  actorEmail String
  actorName  String?
  targetType String // e.g. "Journal"
  targetId   String?
  targetName String?
  summary    String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Global, shared content for the Manuscript page (the same engine for every
// journal). Single row, edited once in /admin/manuscript-engine.
model ManuscriptEngine {
  id        String   @id @default("singleton")
  heading   String?
  leadText  String?
  steps     String[]
  scanLabel String?
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

// Shared About-page closing paragraphs, edited once. Rendered for every journal
// with {journal}/{publisher}/{email} tokens filled in per-journal.
model AboutNotes {
  id         String   @id @default("singleton")
  paragraphs String[]
  updatedAt  DateTime @updatedAt
}

// Email domains permitted to self-onboard via Google sign-in (new accounts are
// created as VIEWER). Managed from /admin/auth-domains. Specific admin emails
// (e.g. amit.rai@celnet.in) are configured via env and bypass this list.
model AllowedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique // lowercase, no "@" — e.g. "celnet.in"
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// People & organisations (defined once, reused everywhere)
// ---------------------------------------------------------------------------

model Profile {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String? // contact tel. shown on the management-page contact boxes
  photoUrl    String?
  signatureUrl String? // handwritten signature image, used on the Director's Desk page
  designation String?
  biography   String?
  affiliation String?
  department  String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships         JournalMember[]
  publisherMemberships PublisherMember[]
  directorOfCompanies Company[]       @relation("CompanyDirector")
  managedDomains      Domain[]        @relation("DomainManager")
  managedJournals     Journal[]       @relation("JournalManager")
  subscriptionManagerOf Publisher[]   @relation("PublisherSubscriptionManager")
  dispatchManagerOf     Publisher[]   @relation("PublisherDispatchManager")

  @@index([email])
  @@index([name])
}

model Company {
  id                String   @id @default(cuid())
  name              String   @unique
  email             String?
  phone             String?
  website           String?
  logoUrl           String?
  registeredAddress String?
  salesAddress      String?
  cin               String?
  gst               String?
  bankAccountName   String?
  bankAccountNo     String?
  bankIfsc          String?
  bankName          String?
  bankBranch        String?
  bankSwift         String?

  // Director's Desk page (the message is signed by the company director below).
  directorDeskTitle      String?
  directorDeskParagraphs String[]

  printedBy String? // print vendor shown on the title page ("Printed by")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  directorId String?
  director   Profile? @relation("CompanyDirector", fields: [directorId], references: [id], onDelete: SetNull)

  publishers Publisher[]
}

model Publisher {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  sealUrl   String? // publisher seal/stamp image (shown near the Director's signature)
  about     String? // imprint blurb shown at the top of the journal-details page (About)
  disciplines String? // fills the {disciplines} token in the Director's Desk letter (e.g. "scientific, technical, and medical disciplines")
  salientFeatures String[] // About-page salient features; publisher-wide (shared by all its journals)
  objectives      String[] // About-page objectives; publisher-wide
  email     String? // publisher contact email (used in the Legal Disputes line)
  phone     String? // publisher contact phone (used in the Legal Disputes line)
  mobile    String? // publisher mobile number (shown on the title-page footer)
  website   String? // publisher website (shown on the title page)
  // When true, the management page lists this publisher's journals (two columns).
  showJournalsOnManagement Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Profiles responsible for subscriptions and dispatch (selected per publisher).
  subscriptionManagerId String?
  subscriptionManager   Profile? @relation("PublisherSubscriptionManager", fields: [subscriptionManagerId], references: [id], onDelete: SetNull)
  dispatchManagerId     String?
  dispatchManager       Profile? @relation("PublisherDispatchManager", fields: [dispatchManagerId], references: [id], onDelete: SetNull)

  // Publication & Management Team shown on every one of this publisher's journals'
  // management page (roles MANAGEMENT_HEAD / MANAGEMENT_MEMBER). Set once per publisher.
  members  PublisherMember[]

  journals Journal[]
}

// Frequency-based subscription pricing. One tier per "issues per year" value
// (e.g. 2 or 3). The Subscription page auto-renders the tier matching the
// journal's issuesPerYear. Editable in /admin/subscription-pricing.
model SubscriptionTier {
  id             String   @id @default(cuid())
  issuesPerYear  Int      @unique
  printInr       Float?
  singleIssueInr Float?
  onlineInr      Float?
  printOnlineInr Float?
  printUsd       Float?
  onlineUsd      Float?
  printOnlineUsd Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Domain {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managerId String?
  manager   Profile? @relation("DomainManager", fields: [managerId], references: [id], onDelete: SetNull)

  journals Journal[]
}

// ---------------------------------------------------------------------------
// Subscriptions (global plans + optional per-journal price override)
// ---------------------------------------------------------------------------

model Subscription {
  id        String           @id @default(cuid())
  name      String           @unique
  mode      SubscriptionMode
  priceUsd  Float?
  priceInr  Float?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  journalOverrides JournalSubscription[]
}

model JournalSubscription {
  id             String  @id @default(cuid())
  journalId      String
  subscriptionId String
  priceUsd       Float?
  priceInr       Float?

  journal      Journal      @relation(fields: [journalId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([journalId, subscriptionId])
}

// ---------------------------------------------------------------------------
// Journal (catalog) + the people attached to it
// ---------------------------------------------------------------------------

model Journal {
  id           String  @id @default(cuid())
  legacyId     String? @unique // original CSV ID/Key, for seeding + lookups
  slug         String  @unique
  name         String
  abbreviation String
  shortName    String?
  website      String?

  issnPrint  String?
  issnOnline String?
  sjif       String?
  icv        String?
  doi        String?

  impactFactor      String?
  indexing          String[]
  codeN             String?
  startedSince      String?
  typeOfPublication String?
  access            String?
  language          String?
  issuesPerYear     Int?
  frequency         JournalFrequency @default(OTHER)
  frequencyLabel    String?

  coverFrontUrl String?
  coverBackUrl  String?

  focusScope       String[]
  focusNotes       String[]
  objectives       String[]
  salientFeatures  String[]
  keywords         String[]
  manuscriptUrl    String? // submission page encoded in the Manuscript page QR code
  editorialBoardUrl String? // full editorial-board page, linked when the board is truncated

  // Per-journal Director's Desk content (overrides the Company-level default).
  directorDeskTitle      String?
  directorDeskParagraphs String[]

  // Subscription plans hidden on this journal's subscription page (denylist;
  // empty = show every priced plan). Plans vary per journal.
  hiddenSubscriptionIds String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainId    String?
  domain      Domain?    @relation(fields: [domainId], references: [id], onDelete: SetNull)
  publisherId String?
  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  managerId   String?
  manager     Profile?   @relation("JournalManager", fields: [managerId], references: [id], onDelete: SetNull)

  members       JournalMember[]
  binders       Binder[]
  subscriptions JournalSubscription[]
  // Login accounts (JOURNAL_MANAGER role) granted edit access to this journal.
  managerUsers  User[]                @relation("JournalManagerUsers")

  @@index([abbreviation])
}

model JournalMember {
  id        String      @id @default(cuid())
  journalId String
  profileId String
  role      JournalRole
  order     Int         @default(0)

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([journalId, profileId, role])
  @@index([journalId])
}

// Publisher-scoped management team. Mirrors JournalMember but tied to a publisher,
// so the management page's team is set once per publisher and shared by all of its
// journals. Only MANAGEMENT_HEAD / MANAGEMENT_MEMBER roles are used here.
model PublisherMember {
  id          String      @id @default(cuid())
  publisherId String
  profileId   String
  role        JournalRole
  order       Int         @default(0)

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([publisherId, profileId, role])
  @@index([publisherId])
}

// ---------------------------------------------------------------------------
// Binder = the editable per-issue document (inherits journal defaults)
// ---------------------------------------------------------------------------

model Binder {
  id        String     @id @default(cuid())
  journalId String
  volume    String?
  issue     String?
  year      Int?
  type      BinderType @default(REGULAR)

  monthRange         String?
  directorParagraphs String[]

  // Per-issue free-form overrides + cover/page layout positions (JSONB).
  overrides Json?
  layout    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  // QA → internal-review workflow. A binder is forwarded to the internal team
  // only after its latest QA run passed (or an admin override, which is logged).
  reviewStatus  BinderReviewStatus @default(DRAFT)
  submittedAt   DateTime?
  submittedById String?

  journal     Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  submittedBy User?     @relation("BinderSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  articles    Article[]
  files       BinderFile[]
  qaRuns      BinderQaRun[]

  @@unique([journalId, volume, issue, year])
  @@index([journalId])
}

model Article {
  id        String  @id @default(cuid())
  binderId  String
  title     String
  authors   String?
  startPage String?
  order     Int     @default(0)

  binder     Binder      @relation(fields: [binderId], references: [id], onDelete: Cascade)
  manuscript BinderFile? // uploaded manuscript PDF for this TOC row

  @@index([binderId])
}

// ---------------------------------------------------------------------------
// Uploaded image storage (bytes in Postgres)
// ---------------------------------------------------------------------------

model Asset {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  byteSize  Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Binder QA module (PDF storage + AI quality-assurance runs)
// ---------------------------------------------------------------------------

// A PDF stored against a binder: the front-matter export, one manuscript per
// TOC article, or the assembled final binder. Bytes live in Postgres like Asset.
model BinderFile {
  id        String         @id @default(cuid())
  binderId  String
  kind      BinderFileKind
  articleId String?        @unique // MANUSCRIPT only — one PDF per TOC row
  filename  String?
  data      Bytes
  byteSize  Int
  pageCount Int?
  // ASSEMBLED only: { frontMatterPages, articles: [{ articleId, title, startPage, endPage }] }
  meta      Json?
  createdAt DateTime @default(now())

  uploadedById String?
  binder       Binder   @relation(fields: [binderId], references: [id], onDelete: Cascade)
  article      Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  qaRuns       BinderQaRun[]

  @@index([binderId])
}

// One AI QA run over an assembled binder. `report` holds the full AuditReport
// JSON (same shape the draft audit renders); `passed` gates internal review.
model BinderQaRun {
  id         String      @id @default(cuid())
  binderId   String
  status     QaRunStatus @default(RUNNING)
  report     Json?
  counts     Json?
  passed     Boolean     @default(false)
  model      String? // AI model used, null when AI layer was skipped
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  assembledFileId String?
  createdById     String?
  binder          Binder      @relation(fields: [binderId], references: [id], onDelete: Cascade)
  assembledFile   BinderFile? @relation(fields: [assembledFileId], references: [id], onDelete: SetNull)
  createdBy       User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([binderId, createdAt])
}
